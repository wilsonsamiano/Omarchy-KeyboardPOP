pkgname=presspop
pkgver=0.1.0
pkgrel=3
pkgdesc='Touch keyboard for Omarchy with key popups, swipe typing, and suggestions'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'wayland' 'libxkbcommon')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/presspop "$pkgdir/usr/bin/presspop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/presspop.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/presspop.svg"
  install -Dm644 "$startdir/presspop.desktop" "$pkgdir/usr/share/applications/presspop.desktop"
}
