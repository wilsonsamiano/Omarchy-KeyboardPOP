pkgname=keyboardpop
pkgver=0.1.0
pkgrel=13
pkgdesc='Touch keyboard for Omarchy with key popups, swipe typing, and suggestions'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'wayland' 'libxkbcommon')
provides=('presspop')
conflicts=('presspop')
replaces=('presspop')
optdepends=('iio-sensor-proxy: autorotate, for turning the screen with the tablet'
            'jq: autorotate'
            'python: touchswipe, for four-finger desktop swipes')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/keyboardpop "$pkgdir/usr/bin/keyboardpop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/keyboardpop.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/keyboardpop.svg"
  install -Dm644 "$startdir/keyboardpop.desktop" "$pkgdir/usr/share/applications/keyboardpop.desktop"
  install -Dm755 tablet/autorotate "$pkgdir/usr/bin/autorotate"
  install -Dm755 tablet/touchswipe "$pkgdir/usr/bin/touchswipe"
  install -Dm644 "$startdir/70-keyboardpop-touchscreen.rules" "$pkgdir/usr/lib/udev/rules.d/70-keyboardpop-touchscreen.rules"
}
