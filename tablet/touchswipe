#!/usr/bin/env python3
"""iPad-style touchscreen gestures for Omarchy.

- A quick one-finger swipe left or right, anywhere except on the on-screen
  keyboard, switches desktops (left for the next one). So does a
  four-finger swipe.
- A swipe up from the bottom edge opens the Omarchy menu (Super + Space).
- A touch dismisses the Omarchy screensaver.

Swipe four fingers left for the next desktop, right for the previous one.
Hyprland only does gestures on touchpads, so this reads the touchscreen
itself (the KeyboardPOP udev rule lets the logged-in user read it) and calls
desktop_step from ~/.config/hypr/input.lua. It follows auto-rotation through
the state file autorotate writes, so "left" is always the
screen's left. Started hidden at login from ~/.config/hypr/autostart.lua.
"""

import fcntl
import glob
import json
import os
import signal
import struct
import subprocess
import sys
import time

EV_SYN, EV_ABS = 0, 3
SYN_REPORT = 0
ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0x2F, 0x35, 0x36, 0x39
EVENT = struct.Struct("llHHi")

FINGERS = 4
# A swipe crosses at least this much of the screen, mostly sideways.
MIN_TRAVEL = 0.15
SIDEWAYS = 1.5
# A one-finger desktop swipe is a quick flick, so slow drags (selecting
# text, moving a slider) don't count.
FLICK_TRAVEL = 0.2
FLICK_SECONDS = 0.5
# An edge swipe starts this close to the edge and travels this far in.
EDGE = 0.04
EDGE_TRAVEL = 0.12

STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "autorotate", "transform")


def abs_range(fd, code):
    # EVIOCGABS(code): struct input_absinfo is six ints.
    request = (2 << 30) | (24 << 16) | (ord("E") << 8) | (0x40 + code)
    info = struct.unpack("6i", fcntl.ioctl(fd, request, bytes(24)))
    return info[1], info[2]  # minimum, maximum


def find_touchscreen():
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            rdev = os.stat(path).st_rdev
            with open(f"/run/udev/data/c{os.major(rdev)}:{os.minor(rdev)}") as db:
                if "E:ID_INPUT_TOUCHSCREEN=1\n" in db.read():
                    return path
        except OSError:
            continue
    return None


def rotation():
    try:
        with open(STATE) as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def to_screen(x, y):
    """A panel position (0-1 on each axis) as a position on the rotated screen."""
    return {0: (x, y), 1: (y, 1 - x), 2: (1 - x, 1 - y), 3: (1 - y, x)}[rotation() % 4]


def sideways(dx, dy):
    """The swipe's sideways travel on screen, from panel travel."""
    return {0: dx, 1: dy, 2: -dx, 3: -dy}[rotation() % 4], {0: dy, 1: dx, 2: dy, 3: dx}[rotation() % 4]


def hyprctl_json(*args):
    try:
        return json.loads(subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True).stdout)
    except (ValueError, OSError):
        return None


def on_keyboard(point):
    """Whether a screen position (0-1) is on the on-screen keyboard."""
    monitors = hyprctl_json("monitors") or []
    layers = hyprctl_json("layers") or {}
    for monitor in monitors:
        scale = monitor.get("scale") or 1
        width, height = monitor["width"] / scale, monitor["height"] / scale
        if monitor.get("transform", 0) % 2:
            width, height = height, width
        for level in layers.get(monitor["name"], {}).get("levels", {}).values():
            for layer in level:
                if layer.get("namespace") == "keyboardpop":
                    x, y = point[0] * width, point[1] * height
                    if layer["x"] <= x <= layer["x"] + layer["w"] and layer["y"] <= y <= layer["y"] + layer["h"]:
                        return True
    return False


def open_menu():
    subprocess.run(["omarchy-menu", "summon", "root"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def one_finger(start, end, seconds):
    """Acts on a one-finger swipe from `start` to `end` (screen, 0-1)."""
    dx, dy = end[0] - start[0], end[1] - start[1]
    if start[1] >= 1 - EDGE and -dy >= EDGE_TRAVEL and -dy >= SIDEWAYS * abs(dx):
        open_menu()
    elif seconds <= FLICK_SECONDS and abs(dx) >= FLICK_TRAVEL and abs(dx) >= SIDEWAYS * abs(dy):
        if not on_keyboard(start):
            step(1 if dx < 0 else -1)


def dismiss_screensaver():
    """Ends the Omarchy screensaver the way its own exit handler expects.

    It closes on a keypress or when it loses focus, but not on a touch. A
    SIGTERM runs its exit trap, which also brings the cursor back.
    """
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                args = f.read().split(b"\0")
        except OSError:
            continue
        if len(args) > 1 and os.path.basename(args[1]) == b"omarchy-screensaver":
            try:
                os.kill(int(pid), signal.SIGTERM)
            except OSError:
                pass


def step(direction):
    subprocess.run(["hyprctl", "eval", f"desktop_step({direction})"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def watch(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        xmin, xmax = abs_range(fd, ABS_MT_POSITION_X)
        ymin, ymax = abs_range(fd, ABS_MT_POSITION_Y)
        width, height = max(1, xmax - xmin), max(1, ymax - ymin)
        slot = 0
        touches = {}  # slot -> [x, y]
        start = last = None
        # The one-finger gesture: where and when it started, where it is.
        single = single_end = None
        single_since = 0.0
        while True:
            data = os.read(fd, EVENT.size * 64)
            if not data:
                return
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, kind, code, value = EVENT.unpack_from(data, i)
                if kind == EV_ABS:
                    if code == ABS_MT_SLOT:
                        slot = value
                    elif code == ABS_MT_TRACKING_ID:
                        if value < 0:
                            touches.pop(slot, None)
                        else:
                            if not touches:
                                # A first finger down: a touch wakes the screen.
                                dismiss_screensaver()
                            touches[slot] = [None, None]
                    elif code == ABS_MT_POSITION_X and slot in touches:
                        touches[slot][0] = (value - xmin) / width
                    elif code == ABS_MT_POSITION_Y and slot in touches:
                        touches[slot][1] = (value - ymin) / height
                elif kind == EV_SYN and code == SYN_REPORT:
                    placed = [t for t in touches.values() if None not in t]
                    if placed:
                        centre = (sum(t[0] for t in placed) / len(placed), sum(t[1] for t in placed) / len(placed))
                    if start is None and len(placed) >= FINGERS:
                        start = last = centre
                    elif start is not None and len(placed) >= FINGERS - 1:
                        # Fingers lift one at a time; follow while most are down.
                        last = centre
                    # One finger alone from start to finish.
                    if len(touches) == 1 and len(placed) == 1:
                        point = to_screen(*placed[0])
                        if single is None and single_since == 0.0:
                            single, single_since = point, time.monotonic()
                        if single is not None:
                            single_end = point
                    elif len(touches) > 1:
                        single = None
                        single_since = -1.0
                    if not touches:
                        if single is not None and single_end is not None:
                            one_finger(single, single_end, time.monotonic() - single_since)
                        single = single_end = None
                        single_since = 0.0
                    if start is not None and not touches:
                        across, along = sideways(last[0] - start[0], last[1] - start[1])
                        if abs(across) >= MIN_TRAVEL and abs(across) >= SIDEWAYS * abs(along):
                            # Fingers moving left bring the next desktop in.
                            step(1 if across < 0 else -1)
                        start = last = None
    finally:
        os.close(fd)


def main():
    # The touchscreen can vanish across suspend; wait for it and carry on.
    while True:
        path = find_touchscreen()
        if path:
            try:
                watch(path)
            except OSError:
                pass
        time.sleep(2)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
